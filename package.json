{
  "name": "react-native-nitro-sms-monorepo",
  "packageManager": "bun@1.3.5",
  "private": true,
  "version": "0.0.1",
  "repository": "https://github.com/mahibulhaque/react-native-nitro-sms.git",
  "author": "Md Mahibul Haque <mahibulhaque.me> (https://github.com/mahibul)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/react-native-nitro-sms build",
    "specs": "bun run build && bun run --cwd packages/react-native-nitro-sms specs",
    "bootstrap": "bun i && bun run build && cd apps/example && bundle install && bun pods",
    "typecheck": "bun --filter=\"**\" typecheck",
    "lint": "bun sms lint",
    "lint-ci": "bun sms lint-ci",
    "clean": "git clean -dfx",
    "release": "./scripts/release.sh",
    "sms": "bun --cwd packages/react-native-nitro-sms",
    "example": "bun --cwd apps/example"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@release-it-plugins/workspaces": "^5.0.3",
    "@release-it/bumper": "^7.0.5",
    "@release-it/conventional-changelog": "^10.0.4",
    "@tsconfig/react-native": "^3.0.8",
    "@types/bun": "latest",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.7",
    "prettier": "^3.7.4",
    "react": "^19.2.3",
    "react-native": "^0.83.1",
    "release-it": "^19.2.2",
    "typescript": "^5.9.3"
  },
  "release-it": {
    "npm": {
      "publish": false
    },
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}",
      "requireCleanWorkingDir": false
    },
    "github": {
      "release": true
    },
    "hooks": {
      "before:release": "bun i",
      "after:bump": "scripts/try-install-lockfiles.sh"
    },
    "plugins": {
      "@release-it/bumper": {
        "out": [
          {
            "file": "packages/react-native-nitro-sms/package.json",
            "path": "version"
          },
          {
            "file": "apps/example/package.json",
            "path": "version"
          }
        ]
      },
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "✨ Features"
            },
            {
              "type": "perf",
              "section": "💨 Performance Improvements"
            },
            {
              "type": "fix",
              "section": "🐛 Bug Fixes"
            },
            {
              "type": "chore(deps)",
              "section": "🛠️ Dependency Upgrades"
            },
            {
              "type": "docs",
              "section": "📚 Documentation"
            }
          ]
        }
      }
    }
  }
}
